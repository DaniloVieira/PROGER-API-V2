# PROGER API v2.0 — Environment Variables
NODE_ENV=development
PORT=3001

# Oracle Database
DB_HOST=omdes-scan.ds55.local
DB_PORT=1521
DB_NAME=PROGER
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=PROGER

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRATION=3600

# LDAP / Active Directory
LDAP_URL=ldaps://ldap.engie.com.br
LDAP_BASE_DN=DC=engie,DC=com,DC=br

# Historiador / PI System
PI_SERVER_URL=https://pi-server.engie.local
PI_USERNAME=
PI_PASSWORD=

# Outbox Polling
OUTBOX_ENABLED=true
OUTBOX_INTERVAL_MS=30000
